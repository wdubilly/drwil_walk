{
  "name": "drwil-walk-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "licenses": "license-checker-rseidelsohn --summary --excludePrivatePackages --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;BlueOak-1.0.0;CC0-1.0;CC-BY-3.0;CC-BY-4.0;MPL-2.0;Unlicense;Python-2.0'",
    "e2e": "playwright test",
    "extract": "node -e \"import('./scripts/cities.ts').then(m=>m.extractCity(fetch,'souq').then(t=>require('node:fs').writeFileSync(m.CITIES['souq'].file,t)))\"",
    "extract:pune": "node -e \"import('./scripts/cities.ts').then(m=>m.extractCity(fetch,'pune').then(t=>require('node:fs').writeFileSync(m.CITIES['pune'].file,t)))\"",
    "extract:corniche": "node -e \"import('./scripts/cities.ts').then(m=>m.extractCity(fetch,'corniche').then(t=>require('node:fs').writeFileSync(m.CITIES['corniche'].file,t)))\"",
    "extract:fc-road": "node -e \"import('./scripts/cities.ts').then(m=>m.extractCity(fetch,'fc-road').then(t=>require('node:fs').writeFileSync(m.CITIES['fc-road'].file,t)))\""
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "iwer": "^2.7.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "three": "^0.187.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.3"
  }
}
