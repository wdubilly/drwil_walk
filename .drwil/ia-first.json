{
  "projectName": "drwil_walk",
  "projectShort": "drwil_walk",
  "lang": "fr",
  "layers": [
    "app"
  ],
  "contractPrefixes": [
    "SEC",
    "QUA"
  ],
  "tools": [
    "claude"
  ],
  "ci": "github",
  "dirs": {
    "projects": "docs/projects",
    "intentions": "docs/intentions",
    "recipes": "docs/recipes",
    "contracts": "docs/contracts.md",
    "index": "docs/projects/pending.md"
  },
  "stack": [],
  "checks": [
    {
      "id": "file-size",
      "name": "taille des fichiers de code (QUA-001)",
      "run": "node .githooks/check-file-size.mjs app 200 ts,tsx,js,jsx,mjs,cjs"
    },
    {
      "id": "coverage-app",
      "name": "coverage of app (c8)",
      "run": "npx c8 --check-coverage --lines 100 --branches 100 --functions 100 --statements 100 --all npm test",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    },
    {
      "id": "coverage-diff-app",
      "name": "couverture différentielle de app à 100 % (c8 + diff-cover contre origin/master, QUA-004)",
      "run": "npx c8 --reporter=cobertura --report-dir=coverage npm test && diff-cover coverage/cobertura-coverage.xml --compare-branch=origin/master --fail-under=100",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    },
    {
      "id": "typecheck-app",
      "name": "typage strict de app (tsc --noEmit, QUA-005)",
      "run": "npm run typecheck",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    },
    {
      "id": "lint-app",
      "name": "lint de app sans avertissement (ESLint, QUA-002, QUA-005, QUA-007, QUA-008)",
      "run": "npm run lint",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    },
    {
      "id": "licenses-app",
      "name": "licences des dépendances de app (SEC-012)",
      "run": "npm run licenses",
      "cwd": "app",
      "paths": [
        "app/package.json",
        "app/package-lock.json"
      ],
      "degradable": false
    },
    {
      "id": "app-001",
      "name": "APP-001 sécurité-visibilité : tests nommés par l'ID (Vitest)",
      "run": "npm test -- -t \"APP-001\"",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    },
    {
      "id": "app-002",
      "name": "APP-002 la marche suit le parcours GPS du souk : tests nommés par l'ID (Vitest)",
      "run": "npm test -- -t \"APP-002\"",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    },
    {
      "id": "app-003",
      "name": "APP-003 bâtiments OpenStreetMap et attribution : tests nommés par l'ID (Vitest)",
      "run": "npm test -- -t \"APP-003\"",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    },
    {
      "id": "app-004",
      "name": "APP-004 champ de vision du casque simulé : tests nommés par l'ID (Vitest)",
      "run": "npm test -- -t \"APP-004\"",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    },
    {
      "id": "e2e",
      "name": "e2e des chemins critiques (Playwright, Quest 3 émulé par IWER, QUA-020)",
      "run": "npm run e2e",
      "cwd": "app",
      "paths": [
        "app/**"
      ],
      "degradable": false
    }
  ],
  "scopeReminder": "blocking",
  "transitions": "human",
  "scopeGate": "warning",
  "newRequirements": "blocking",
  "layerPrefixes": [
    "app",
    "tests",
    "src",
    "scripts"
  ],
  "codePrefixes": [
    "scripts",
    ".githooks",
    "e2e"
  ],
  "extraCodeFiles": [],
  "extraCodeGlobs": [
    "docker-compose*.yml"
  ],
  "ciFiles": [
    ".github/workflows/ia-first.yml"
  ],
  "mode": "full",
  "risk": {
    "sensitivePaths": [
      ".githooks/*",
      ".github/workflows/*",
      ".gitlab-ci.yml",
      ".drwil/*",
      "app/*"
    ]
  },
  "guarantees": {
    "enforced": true,
    "layers": {
      "app": "existing"
    },
    "protection": {
      "forge": "github",
      "branch": "master",
      "verifiedAt": "2026-10-30"
    }
  }
}
