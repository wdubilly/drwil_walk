# Copy to .env (not versioned, see .gitignore) and fill in.
# A secret never goes into this .env.example file nor into the code
# (SEC-007): only example or empty values here.

# Google Photorealistic 3D Tiles (optional rendering, see INSTALL.md): the app reads this key from app/.env.local
# (not versioned). The value below is a FICTITIOUS placeholder: put the real key only in app/.env.local, never here.
VITE_GOOGLE_MAPS_API_KEY=cle-fictive-a-remplacer-dans-app-env-local

# Itinéraire libre : par défaut, AUCUNE clé (Valhalla pour le chemin, Photon pour les adresses, instances publiques d'OpenStreetMap).
# Adresses non secrètes, à régler seulement pour une instance auto-hébergée (valeurs d'exemple fictives) :
# VITE_ROUTING_URL=http://localhost:8002
# VITE_GEOCODING_URL=http://localhost:2322

# Option Google (voir INSTALL.md) : une clé Google DISTINCTE de la précédente, lue de app/.env.local. Elle remplace Valhalla et Photon
# par Routes et Geocoding (les deux API doivent être activées et autorisées dans la restriction de cette clé). La valeur ci-dessous
# est FICTIVE : la vraie clé va seulement dans app/.env.local.
VITE_GOOGLE_ROUTES_API_KEY=cle-routes-fictive-a-remplacer-dans-app-env-local
